# =============================================================================
# GREENHOUSE IoT PLATFORM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=greenhouse

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenhouse_db
POSTGRES_USER=greenhouse_user
POSTGRES_PASSWORD=change_me_postgres_password

# Full DSN (used by Prisma / NestJS)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Full URL (used by NestJS / BullMQ)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# EMQX
# -----------------------------------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_DASHBOARD_PORT=18083

# EMQX Dashboard admin credentials
EMQX_DASHBOARD_DEFAULT_USERNAME=admin
EMQX_DASHBOARD_DEFAULT_PASSWORD=change_me_emqx_dashboard_password

# EMQX API credentials (used by NestJS to call EMQX REST API)
EMQX_API_KEY=change_me_emqx_api_key
EMQX_API_SECRET=change_me_emqx_api_secret

# MQTT credentials used by NestJS backend
MQTT_BROKER_URL=mqtt://emqx:1883
MQTT_USERNAME=nestjs_backend
MQTT_PASSWORD=change_me_mqtt_backend_password

# -----------------------------------------------------------------------------
# NESTJS API (Phase 2 — do not use yet)
# -----------------------------------------------------------------------------
API_PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# AI SERVICE (Phase — do not use yet)
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai:8000
AI_API_KEY=change_me_ai_api_key
