# =============================================================================
# GREENHOUSE IoT PLATFORM — Environment Variables
# =============================================================================
# Reference variable names only. Inject credentials/URLs from a secret manager;
# placeholder values below are intentionally unusable. NEVER commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=greenhouse

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenhouse_db
POSTGRES_USER=<local-db-user>
POSTGRES_PASSWORD=<inject-from-secret-manager>

# Full DSN (used by Prisma / NestJS)
DATABASE_URL=<inject-complete-database-url-from-secret-manager>

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<inject-from-secret-manager>

# Full URL (used by NestJS / BullMQ)
REDIS_URL=<inject-complete-redis-url-from-secret-manager>

# -----------------------------------------------------------------------------
# EMQX
# -----------------------------------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_DASHBOARD_PORT=18083

# EMQX Dashboard admin credentials
EMQX_DASHBOARD_DEFAULT_USERNAME=admin
EMQX_DASHBOARD_DEFAULT_PASSWORD=<inject-from-secret-manager>

# EMQX API credentials (used by NestJS to call EMQX REST API)
EMQX_API_KEY=<inject-from-secret-manager>
EMQX_API_SECRET=<inject-from-secret-manager>

# MQTT credentials used by NestJS backend
MQTT_BROKER_URL=mqtt://emqx:1883
MQTT_USERNAME=nestjs_backend
MQTT_PASSWORD=<inject-from-secret-manager>

# -----------------------------------------------------------------------------
# NESTJS API (Phase 2 — do not use yet)
# -----------------------------------------------------------------------------
API_PORT=3000
NODE_ENV=development
JWT_SECRET=<inject-from-secret-manager>
JWT_REFRESH_SECRET=<inject-from-secret-manager>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# AI SERVICE (Phase — do not use yet)
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai:8000
AI_API_KEY=<inject-from-secret-manager>
