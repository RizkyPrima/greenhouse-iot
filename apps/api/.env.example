NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Inject the complete URL from a local/deployment secret manager. This placeholder is unusable.
DATABASE_URL=<inject-complete-database-url-from-secret-manager>

# Inject the complete URL from a local/deployment secret manager. This placeholder is unusable.
REDIS_URL=<inject-complete-redis-url-from-secret-manager>

# MQTT (EMQX) — Phase 3
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=greenhouse-api
MQTT_KEEPALIVE=30
MQTT_CONNECT_TIMEOUT=10000
MQTT_RECONNECT_PERIOD=3000
MQTT_CLEAN=true

# JWT (Phase 6 — Authentication)
JWT_SECRET=<inject-from-secret-manager>
JWT_REFRESH_SECRET=<inject-from-secret-manager>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
