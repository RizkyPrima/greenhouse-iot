NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database — use localhost when NestJS runs on host
DATABASE_URL=postgresql://greenhouse_user:change_me_postgres_password@localhost:5432/greenhouse_db

# Redis — use localhost when NestJS runs on host
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# MQTT (EMQX) — Phase 3
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=greenhouse-api
MQTT_KEEPALIVE=30
MQTT_CONNECT_TIMEOUT=10000
MQTT_RECONNECT_PERIOD=3000
MQTT_CLEAN=true

# JWT (Phase 6 — Authentication)
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
