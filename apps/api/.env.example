NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Inject the complete URL from a local/deployment secret manager. This placeholder is unusable.
DATABASE_URL=<inject-complete-database-url-from-secret-manager>

# Inject the complete URL from a local/deployment secret manager. This placeholder is unusable.
REDIS_URL=<inject-complete-redis-url-from-secret-manager>

# MQTT (EMQX)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
# Credentials of an existing EMQX backend user. Required; anonymous fallback is disabled.
MQTT_USERNAME=nestjs_backend
MQTT_PASSWORD=<inject-from-secret-manager>
MQTT_CLIENT_ID=greenhouse-api
MQTT_KEEPALIVE=30
MQTT_CONNECT_TIMEOUT=10000
MQTT_RECONNECT_PERIOD=3000
MQTT_CLEAN=true

# Simulator: use only explicitly registered TEST greenhouse/device IDs and a
# disposable database whose name contains "test". Enable writes only for that database.
SIM_GH_ID=
SIM_DEVICE_ID=
SIMULATOR_ALLOW_DB_WRITES=false

# Optional: set all three to let NestJS create/update the backend MQTT user and ACL.
# Leave all three unset to authenticate with the pre-provisioned existing user above.
EMQX_API_URL=http://localhost:18083/api/v5
EMQX_API_KEY=<inject-from-secret-manager>
EMQX_API_SECRET=<inject-from-secret-manager>
# For production, set MQTT_PROTOCOL=mqtts and EMQX_API_URL to a trusted HTTPS endpoint.

# JWT (Phase 6 — Authentication)
JWT_SECRET=<inject-from-secret-manager>
JWT_REFRESH_SECRET=<inject-from-secret-manager>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Select the preferred provider; the other configured provider is a failover.
LLM_PROVIDER=GEMINI
GEMINI_API_KEY=<set-in-backend-secret-store>
OPENAI_API_KEY=<set-in-backend-secret-store>
# Optional model overrides. Defaults: gemini-3.8-flash and gpt-5.4-mini.
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-5.4-mini
