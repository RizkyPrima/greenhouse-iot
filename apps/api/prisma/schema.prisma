datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GreenhouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ONLINE
  STALE
  OFFLINE
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  EXECUTED
  FAILED
  TIMEOUT
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
  AI_AGENT
}

enum PlantCatalogStatus {
  ACTIVE
  ARCHIVED
}

enum PlantVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PlantProfileStatus {
  ACTIVE
  ARCHIVED
}

enum PlantProfileVersionStatus {
  DRAFT
  VALIDATED
  RETIRED
}

enum ZonePlantAssignmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PlatformPermission {
  PLANT_CATALOG_ADMIN
}

// ─── Authentication / User Models ────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrganizationMembership[]
  refreshSessions RefreshSession[]
  controlCommands ControlCommand[]
  platformGrants PlatformAdminGrant[] @relation("PlatformGrantSubject")
  grantsIssued PlatformAdminGrant[] @relation("PlatformGrantIssuer")
  plantCatalogVersionsCreated PlantCatalogVersion[] @relation("CatalogVersionCreator")
  plantCatalogVersionsPublished PlantCatalogVersion[] @relation("CatalogVersionPublisher")
  plantProfilesCreated PlantProfile[] @relation("PlantProfileCreator")
  plantProfileVersionsCreated PlantProfileVersion[] @relation("PlantProfileVersionCreator")
  plantProfileVersionsValidated PlantProfileVersion[] @relation("PlantProfileVersionValidator")
  plantAssignmentsCreated ZonePlantAssignment[] @relation("PlantAssignmentCreator")
  zoneOverridesCreated ZoneParameterOverride[] @relation("ZoneOverrideCreator")
  plantConfigAuditEvents PlantConfigAuditEvent[]

  @@map("users")
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  greenhouses Greenhouse[]
  memberships OrganizationMembership[]
  plantProfiles PlantProfile[]
  plantProfileVersions PlantProfileVersion[]
  zonePlantAssignments ZonePlantAssignment[]
  plantConfigAuditEvents PlantConfigAuditEvent[]

  @@map("organizations")
}

model Greenhouse {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  location       String?
  timezone       String
  status         GreenhouseStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zones        Zone[]
  devices      Device[]
  plantAssignments ZonePlantAssignment[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("greenhouses")
}

model Zone {
  id           String     @id @default(cuid())
  greenhouseId String
  name         String
  code         String
  description  String?
  status       ZoneStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  greenhouse Greenhouse @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  devices    Device[]
  sensors    Sensor[]
  actuators  Actuator[]
  plantAssignments ZonePlantAssignment[]

  @@unique([greenhouseId, code])
  @@unique([id, greenhouseId])
  @@index([greenhouseId])
  @@map("zones")
}

model Device {
  id              String       @id @default(cuid())
  greenhouseId    String
  zoneId          String?
  deviceId        String       @unique
  name            String
  deviceType      String
  firmwareVersion String?
  hardwareVersion String?
  status          DeviceStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  greenhouse       Greenhouse        @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  zone             Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sensors          Sensor[]
  actuators        Actuator[]
  telemetryRecords TelemetryRecord[]
  controlCommands  ControlCommand[]

  @@index([greenhouseId])
  @@index([zoneId])
  @@map("devices")
}

model Sensor {
  id         String    @id @default(cuid())
  deviceId   String
  zoneId     String?
  name       String
  code       String
  sensorType String
  unit       String?
  enabled    Boolean   @default(true)
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  zone            Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  telemetryValues TelemetryValue[]

  @@unique([deviceId, code])
  @@index([deviceId])
  @@index([zoneId])
  @@map("sensors")
}

model Actuator {
  id           String    @id @default(cuid())
  deviceId     String
  zoneId       String?
  name         String
  code         String
  actuatorType String
  enabled      Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  zone   Zone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  controlCommands ControlCommand[]

  @@unique([deviceId, code])
  @@index([deviceId])
  @@index([zoneId])
  @@map("actuators")
}

model TelemetryRecord {
  id             String    @id @default(cuid())
  deviceId       String
  deviceMqttId   String
  greenhouseId   String
  sequenceNumber Int?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  rawPayload     Json

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  values TelemetryValue[]

  @@unique([deviceId, sequenceNumber])
  @@index([deviceId])
  @@index([greenhouseId])
  @@index([receivedAt])
  @@map("telemetry_records")
}

model TelemetryValue {
  id                String   @id @default(cuid())
  telemetryRecordId String
  sensorId          String?
  sensorCode        String
  numericValue      Float?
  stringValue       String?
  unit              String?
  timestamp         DateTime

  record TelemetryRecord @relation(fields: [telemetryRecordId], references: [id], onDelete: Cascade)
  sensor Sensor?         @relation(fields: [sensorId], references: [id], onDelete: SetNull)

  @@index([telemetryRecordId])
  @@index([sensorId])
  @@index([timestamp])
  @@map("telemetry_values")
}

model DeviceStatusLog {
  id              String       @id @default(cuid())
  deviceMqttId    String
  greenhouseId    String
  status          DeviceStatus
  ipAddress       String?
  rssi            Int?
  freeHeap        Int?
  uptime          Int?
  firmwareVersion String?
  rawPayload      Json?
  receivedAt      DateTime     @default(now())

  @@index([deviceMqttId])
  @@index([greenhouseId])
  @@index([receivedAt])
  @@map("device_status_logs")
}

model ControlCommand {
  id              String        @id @default(cuid())
  commandId       String        @unique
  deviceId        String
  actuatorId      String?
  userId          String?
  command         String
  target          String
  value           Json
  status          CommandStatus @default(PENDING)
  result          Json?
  error           String?
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  acknowledgedAt  DateTime?
  completedAt     DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actuator Actuator? @relation(fields: [actuatorId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([actuatorId])
  @@index([userId])
  @@index([commandId])
  @@map("control_commands")
}

// Platform-wide catalog access is independent of tenant membership.
model PlatformAdminGrant {
  id             String             @id @default(cuid())
  userId         String
  permission     PlatformPermission
  grantedByUserId String?
  grantedAt      DateTime           @default(now())
  revokedAt      DateTime?
  user           User               @relation("PlatformGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy      User?              @relation("PlatformGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, permission])
  @@map("platform_admin_grants")
}

model PlantCatalog {
  id             String              @id @default(cuid())
  code           String              @unique
  scientificName String
  commonName     String
  cultivar       String?
  status         PlantCatalogStatus  @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  versions       PlantCatalogVersion[]
  profiles       PlantProfile[]

  @@map("plant_catalogs")
}

model PlantCatalogVersion {
  id                   String             @id @default(cuid())
  plantCatalogId       String
  version              Int
  status               PlantVersionStatus @default(DRAFT)
  configSchemaVersion  String             @default("plant-config/v1")
  profileDefaults      Json               @default("{}")
  stageTemplates       Json               @default("[]")
  edgeCompatibility    Json?
  checksumAlgorithm    String             @default("SHA-256/JCS-RFC8785")
  checksum             String?
  createdByUserId      String
  publishedByUserId    String?
  createdAt            DateTime           @default(now())
  publishedAt          DateTime?
  plantCatalog         PlantCatalog       @relation(fields: [plantCatalogId], references: [id], onDelete: Restrict)
  createdBy            User               @relation("CatalogVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy          User?              @relation("CatalogVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  parameterDefinitions PlantParameterDefinition[]
  profileVersions      PlantProfileVersion[]

  @@unique([plantCatalogId, version])
  @@unique([id, plantCatalogId])
  @@index([status, publishedAt])
  @@map("plant_catalog_versions")
}

model PlantParameterDefinition {
  id                    String             @id @default(cuid())
  plantCatalogVersionId String
  parameterKey          String
  label                 String
  dataType              String
  unit                  String?
  metadataSchema        Json               @default("{}")
  valueSchema           Json
  createdAt             DateTime           @default(now())
  plantCatalogVersion   PlantCatalogVersion @relation(fields: [plantCatalogVersionId], references: [id], onDelete: Restrict)

  @@unique([plantCatalogVersionId, parameterKey])
  @@index([plantCatalogVersionId])
  @@map("plant_parameter_definitions")
}

model PlantProfile {
  id             String            @id @default(cuid())
  organizationId String
  plantCatalogId String
  code           String
  name           String
  status         PlantProfileStatus @default(ACTIVE)
  createdByUserId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plantCatalog   PlantCatalog      @relation(fields: [plantCatalogId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("PlantProfileCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions       PlantProfileVersion[]

  @@unique([organizationId, code])
  @@unique([id, organizationId, plantCatalogId])
  @@map("plant_profiles")
}

model PlantProfileVersion {
  id                       String                    @id @default(cuid())
  plantProfileId           String
  organizationId           String
  plantCatalogId           String
  version                  Int
  sourceCatalogVersionId   String
  adoptedFromVersionId     String?
  status                   PlantProfileVersionStatus @default(DRAFT)
  configSchemaVersion      String
  profileConfig            Json                      @default("{}")
  checksumAlgorithm        String                    @default("SHA-256/JCS-RFC8785")
  checksum                 String?
  createdByUserId          String
  validatedByUserId        String?
  createdAt                DateTime                  @default(now())
  validatedAt              DateTime?
  plantProfile             PlantProfile              @relation(fields: [plantProfileId, organizationId, plantCatalogId], references: [id, organizationId, plantCatalogId], onDelete: Restrict)
  sourceCatalogVersion     PlantCatalogVersion       @relation(fields: [sourceCatalogVersionId, plantCatalogId], references: [id, plantCatalogId], onDelete: Restrict)
  adoptedFrom              PlantProfileVersion?      @relation("ProfileVersionAdoption", fields: [adoptedFromVersionId, plantProfileId], references: [id, plantProfileId], onDelete: Restrict)
  adoptedBy                PlantProfileVersion[]     @relation("ProfileVersionAdoption")
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                User                      @relation("PlantProfileVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  validatedBy              User?                     @relation("PlantProfileVersionValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  growthStages             GrowthStage[]
  assignments              ZonePlantAssignment[]

  @@unique([plantProfileId, version])
  @@unique([id, organizationId])
  @@unique([id, plantProfileId])
  @@index([organizationId, status])
  @@map("plant_profile_versions")
}

model GrowthStage {
  id                   String             @id @default(cuid())
  plantProfileVersionId String
  code                 String
  label                String
  sequence             Int
  minDurationDays      Int?
  maxDurationDays      Int?
  transitionCriteria   Json?
  plantProfileVersion  PlantProfileVersion @relation(fields: [plantProfileVersionId], references: [id], onDelete: Restrict)
  parameterConfig      StageParameterConfig?
  assignments          ZonePlantAssignment[]

  @@unique([plantProfileVersionId, code])
  @@unique([plantProfileVersionId, sequence])
  @@unique([id, plantProfileVersionId])
  @@map("growth_stages")
}

model StageParameterConfig {
  id                   String     @id @default(cuid())
  growthStageId        String     @unique
  config               Json       @default("{}")
  configSchemaVersion  String
  checksumAlgorithm   String     @default("SHA-256/JCS-RFC8785")
  checksum             String?
  growthStage          GrowthStage @relation(fields: [growthStageId], references: [id], onDelete: Restrict)

  @@map("stage_parameter_configs")
}

model ZonePlantAssignment {
  id                    String                   @id @default(cuid())
  zoneId                String
  greenhouseId          String
  organizationId        String
  plantProfileVersionId String
  growthStageId         String
  status                ZonePlantAssignmentStatus @default(ACTIVE)
  activatedAt           DateTime                 @default(now())
  endedAt               DateTime?
  assignedByUserId      String
  createdAt             DateTime                 @default(now())
  zone                  Zone                     @relation(fields: [zoneId, greenhouseId], references: [id, greenhouseId], onDelete: Restrict)
  greenhouse            Greenhouse               @relation(fields: [greenhouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plantProfileVersion   PlantProfileVersion      @relation(fields: [plantProfileVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  growthStage           GrowthStage              @relation(fields: [growthStageId, plantProfileVersionId], references: [id, plantProfileVersionId], onDelete: Restrict)
  assignedBy            User                     @relation("PlantAssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  overrides             ZoneParameterOverride[]

  @@index([organizationId, zoneId, status])
  @@index([plantProfileVersionId])
  @@map("zone_plant_assignments")
}

model ZoneParameterOverride {
  id                  String                 @id @default(cuid())
  assignmentId        String
  revision            Int
  overrideConfig      Json                   @default("{}")
  configSchemaVersion String
  checksumAlgorithm  String                 @default("SHA-256/JCS-RFC8785")
  checksum            String?
  createdByUserId     String
  createdAt           DateTime               @default(now())
  supersededAt        DateTime?
  assignment          ZonePlantAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("ZoneOverrideCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, revision])
  @@index([assignmentId, supersededAt])
  @@map("zone_parameter_overrides")
}

model PlantConfigAuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  fromChecksum   String?
  toChecksum     String?
  details        Json?
  requestId      String?
  createdAt      DateTime @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("plant_config_audit_events")
}
